{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".game-tests"
  },
  "include": ["src/game/**/*.ts", "src/online/protocol.ts", "server/**/*.ts", "tests/**/*.ts"]
}
